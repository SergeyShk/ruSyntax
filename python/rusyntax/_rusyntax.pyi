import os
from collections.abc import Iterable, Sequence
from pathlib import Path
from typing import Any, final

from anyseg import Document

__all__ = ["Parser", "__version__"]

__version__: str

@final
class Parser:
    def __new__(cls, path: str | os.PathLike[str] | None = None) -> Parser: ...
    def __copy__(self) -> Parser: ...
    def __deepcopy__(self, memo: Any, /) -> Parser: ...
    def __reduce__(self) -> tuple[type[Parser], tuple[Path | None]]: ...
    @property
    def path(self) -> Path | None: ...
    @property
    def relations(self) -> list[str]: ...
    @property
    def sources(self) -> dict[str, Any] | None: ...
    def parse(
        self, words: Sequence[str], upos: Sequence[str], feats: Sequence[str | None]
    ) -> list[tuple[int, str]]: ...
    def parse_many(
        self, sentences: Iterable[tuple[Sequence[str], Sequence[str], Sequence[str | None]]]
    ) -> list[list[tuple[int, str]]]: ...
    def annotate(self, document: Document) -> None: ...
    def parse_text(self, text: str) -> Document: ...
